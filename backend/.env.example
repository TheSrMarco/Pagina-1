DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Define una clave propia antes de ejecutar con DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=
# sqlite permite comenzar en local. postgres usa las variables PG*.
DB_ENGINE=sqlite
PGDATABASE=piuttec
PGUSER=postgres
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
